pos = 0;
loop = 0;
while (loop < 8) {
  if (pos == 0) {
    line = "🍣　　🍣　　🍣　　";
  } else {
    if (pos == 1) {
      line = "　🍣　　🍣　　🍣　";
    } else {
      if (pos == 2) {
        line = "　　🍣　　🍣　　🍣";
      } else {
        line = "　　　🍣　　🍣　　🍣";
      }
    }
  }

  print "\u001b[2K\u001b[1A" + line;
  msleep 80;

  pos = pos + 1;
  if (pos > 2) {
    pos = 0;
  }
  loop = loop + 1;
}

